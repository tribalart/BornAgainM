<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>BornAgainM</RootNamespace>
		<LangVersion>default</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>BornAgainM</AssemblyName>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Point this at your own Born Again install. Every reference below derives from it.
		     The Il2CppAssemblies folder only exists after the game has been run once with MelonLoader. -->
		<GameDir>C:\Program Files (x86)\Steam\steamapps\common\Born Again</GameDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- All Il2Cpp proxy assemblies (populated by MelonLoader's Il2CppAssemblyGenerator
		     the first time the game is run). Referenced as a whole folder, so no per-DLL list. -->
		<Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll" />

		<!-- MelonLoader runtime (net6). -->
		<Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" />
		<Reference Include="$(GameDir)\MelonLoader\net6\0Harmony.dll" />
		<Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" />
		<Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Common.dll" />
	</ItemGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="BankManager.cs" />
		<Compile Include="SideOverlays.cs" />
		<Compile Include="BossGuiNative.cs" />
		<Compile Include="OnlinePlayersNative.cs" />
		<Compile Include="BossDamageNative.cs" />
		<Compile Include="DpsMeter.cs" />
		<Compile Include="Core.cs" />
	</ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	<Exec Command="COPY &quot;$(TargetPath)&quot; &quot;$(GameDir)\Mods&quot;" />
	</Target>
</Project>